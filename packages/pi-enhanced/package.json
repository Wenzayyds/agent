{
	"name": "@wz-agent/pi-enhanced",
	"version": "0.1.0",
	"description": "Optional MCP policy, memory, context, and task manager extensions for Pi",
	"type": "module",
	"private": true,
	"sideEffects": false,
	"files": [
		"extensions",
		"src",
		"scripts",
		"benchmarks",
		"docs",
		"python",
		"!python/**/__pycache__",
		"!python/**/*.pyc",
		"!python/**/.pytest_cache",
		"!python/**/.venv",
		"!python/**/models",
		"!python/**/indexes",
		"!python/**/tests",
		"README.md"
	],
	"scripts": {
		"check": "tsc --noEmit -p ../../tsconfig.json",
		"check:evaluation": "tsc --noEmit -p tsconfig.evaluation.json",
		"test": "vitest --run",
		"evaluate:p5": "node --experimental-strip-types benchmarks/p5-evaluation.ts",
		"evaluate:real-agent": "node --experimental-strip-types benchmarks/real-agent/run-real-agent.ts",
		"evaluate:ablation": "node --experimental-strip-types benchmarks/real-agent/run-ablation.ts",
		"evaluate:quality": "node --experimental-strip-types benchmarks/quality-evaluation.ts",
		"smoke:docker": "node --experimental-strip-types scripts/ci/docker-isolation-smoke.ts",
		"test:sandbox": "vitest --run tests/unit/sandbox-protocol.test.ts tests/e2e/sandbox-agent-session.test.ts",
		"check:pack": "node --experimental-strip-types scripts/ci/pack-leak-check.ts",
		"data": "node --experimental-strip-types scripts/data-management.ts"
	},
	"keywords": [
		"pi-package",
		"coding-agent"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./extensions/mcp-policy.ts",
			"./extensions/memory.ts",
			"./extensions/context.ts",
			"./extensions/task-manager.ts",
			"./extensions/sandbox.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-mcp": "1.4.0",
		"@types/node": "22.19.19",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
