{
	"name": "@wz-agent/pi-enhanced",
	"version": "0.1.0",
	"description": "Optional MCP policy, memory, context, and task manager extensions for Pi",
	"type": "module",
	"private": true,
	"sideEffects": false,
	"files": [
		"extensions",
		"src",
		"docs",
		"README.md"
	],
	"scripts": {
		"check": "tsc --noEmit -p ../../tsconfig.json",
		"test": "vitest --run"
	},
	"keywords": [
		"pi-package",
		"coding-agent"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./extensions/mcp-policy.ts",
			"./extensions/memory.ts",
			"./extensions/context.ts",
			"./extensions/task-manager.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-mcp": "1.4.0",
		"@types/node": "22.19.19",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
